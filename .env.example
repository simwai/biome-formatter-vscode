# --- Release Configuration ---
# GitHub Personal Access Token for semantic-release
GH_TOKEN=your_github_token_here
# VS Code Marketplace Personal Access Token for publishing
VSCE_PAT=your_vsce_pat_here

# --- Logging & Debugging ---
# Log level for Rust components (off, error, warn, info, debug, trace)
RUST_LOG=info
# Log level for Biome (off, error, warn, info, debug, trace)
BIOME_LOG=info

# --- Testing ---
# Set to "true" when running tests
TEST=false
# Set to "true" for single folder workspace tests
SINGLE_FOLDER_WORKSPACE=false
# Set to "true" for multi folder workspace tests
MULTI_FOLDER_WORKSPACE=false

# --- Experimental Features ---
# Custom path for tsgolint (if used)
# BIOME_TSGOLINT_PATH=
# Suppress program diagnostics for tsgolint
# BIOME_TSGOLINT_DANGEROUSLY_SUPPRESS_PROGRAM_DIAGNOSTICS=true
