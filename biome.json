{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src",
      "**/*",
      "!!.vscode-test",
      "!!node_modules",
      "!!**/*.vsix",
      "!!*out*",
      "!!dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noBannedTypes": "error",
        "noStaticOnlyClass": "error",
        "noUselessLoneBlockStatements": "error",
        "useArrowFunction": "warn",
        "useLiteralKeys": "error"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noBarrelFile": "off"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "noNamespace": "off",
        "noNegationElse": "warn",
        "noNonNullAssertion": "warn",
        "noParameterAssign": "error",
        "useConst": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noApproximativeNumericConstant": "warn",
        "noConfusingVoidType": "error",
        "noConsole": "warn",
        "noConstEnum": "error",
        "noEmptyBlock": "warn",
        "noExplicitAny": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
