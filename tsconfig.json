{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "lib": ["ES2021"],
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    // why: tsc auto-inclusion misses @types/mocha, so the TDD runner globals need an explicit list
    "types": ["mocha", "node", "vscode"],
    "noUnusedLocals": true
  },
  "include": ["./client", "./tests"],
  "exclude": ["./node_modules", "./.vscode-test"]
}
